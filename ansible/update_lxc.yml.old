---
- name:  update 
  hosts: server lxc
  become: true
  tasks: 
    - name: Update all packages to their latest version
      ansible.builtin.apt:
       name: "*"
       state: latest
      register: result

    - name: Remove dependencies that are no longer required
      ansible.builtin.apt:
        autoremove: yes
      register: result
    - name: Show Output
      debug: msg="{{ result.stdout_lines }}"

